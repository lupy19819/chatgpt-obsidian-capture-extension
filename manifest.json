{
  "manifest_version": 3,
  "name": "ChatGPT Obsidian Capture",
  "version": "0.1.0",
  "description": "Manually export the currently loaded ChatGPT conversation to Markdown and JSON for local Obsidian archiving.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "ChatGPT 当前对话归档",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/auto_watcher.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
